# TANK Environment Configuration (Example)
# DO NOT commit actual API keys or secrets here.
# Copy this file to .env.local for local development.

# Supabase Authentication & Database Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side only Gemini API key placeholder (DO NOT prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Configuration
NEXT_PUBLIC_APP_NAME="TANK"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
